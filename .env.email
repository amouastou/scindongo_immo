# ==========================================
# CONFIGURATION EMAIL POUR SCINDONGO IMMO
# ==========================================

# Pour utiliser GMAIL SMTP (recommandé pour tests)
# 1. Activez la validation en 2 étapes sur votre compte Gmail
# 2. Créez un "Mot de passe d'application" : https://myaccount.google.com/apppasswords
# 3. Copiez les valeurs ci-dessous dans votre .env

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-application
DEFAULT_FROM_EMAIL=noreply@scindongo.com
SITE_URL=http://localhost:8000

# ==========================================
# ALTERNATIVE : SENDGRID (Pour production)
# ==========================================
# Plus fiable que Gmail, 100 emails/jour gratuits
# https://sendgrid.com

# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
