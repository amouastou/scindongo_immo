# ==========================================
# CONFIGURATION SCINDONGO IMMO
# ==========================================

# Django
DJANGO_SECRET_KEY=change-me-in-production-use-long-random-string
DJANGO_DEBUG=1  # 1 = Debug ON (dev), 0 = Debug OFF (prod)

# Production Mode (HTTPS/SSL)
# 0 = Développement (localhost, HTTP)
# 1 = Production (HTTPS obligatoire)
PRODUCTION_MODE=0

# Database PostgreSQL
POSTGRES_DB=scindongo_immo
POSTGRES_USER=scindongo
POSTGRES_PASSWORD=scindongo
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis Cache
REDIS_URL=redis://redis:6379/0

# Email SMTP (Gmail)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=amadoubousso50@gmail.com
EMAIL_HOST_PASSWORD=ikgkewxcxtbpuieh
DEFAULT_FROM_EMAIL=noreply@scindongo.com

# Site URL (pour les emails)
SITE_URL=http://localhost:8000

# Allowed Hosts (séparés par des virgules)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Origins (séparés par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==========================================
# NOTES IMPORTANTES
# ==========================================
# 
# EN DÉVELOPPEMENT (localhost) :
# - PRODUCTION_MODE=0
# - DJANGO_DEBUG=1
# - SITE_URL=http://localhost:8000
# - Pas de HTTPS
#
# EN PRODUCTION (serveur réel) :
# - PRODUCTION_MODE=1  ← ACTIVER HTTPS
# - DJANGO_DEBUG=0
# - SITE_URL=https://votre-domaine.com
# - Certificat SSL requis (Let's Encrypt gratuit)
# - DJANGO_SECRET_KEY : générer une clé forte unique
# - POSTGRES_PASSWORD : mot de passe fort
# - EMAIL_HOST_PASSWORD : mot de passe d'application Gmail
#
